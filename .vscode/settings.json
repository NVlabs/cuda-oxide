{
    // Project-level editor settings, tracked in git. Keep personal preferences
    // (fonts, colours, keybindings) in your VS Code User settings instead.
    "rust-analyzer.rustc.source": "discover",
    "rust-analyzer.cargo.features": "all",
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.procMacro.attributes.enable": true,
    // "rust-analyzer.cargo.extraEnv": {
    //     "LIBMATHDX_PATH": "/path/to/libmathdx/install"
    // },
    "files.exclude": {
        "**/target/flycheck*": true,
    },
    // Every example under crates/rustc-codegen-cuda/examples/ and cuteir/examples/
    // is its own cargo workspace, so rust-analyzer only sees the ones listed
    // here. Add the ones you are working on. Every path must exist on the
    // checked-out branch, or rust-analyzer reports "Failed to load workspaces".
    "rust-analyzer.linkedProjects": [
        "./Cargo.toml",
        "./crates/rustc-codegen-cuda/Cargo.toml",
        // cute-layout, cute-rs and dialect-cute are root-workspace members
        // (covered by ./Cargo.toml above); there is no cuteir/Cargo.toml.
        // The standalone cuteir examples need their own entries:
        "./cuteir/examples/elementwise_cute/Cargo.toml",
        "./cuteir/examples/blockscale_gemm_cute/Cargo.toml",
        "./cuteir/examples/nvfp4_gemv_cute/Cargo.toml",
        "./crates/rustc-codegen-cuda/examples/ptr_offset_from/Cargo.toml",
        "./crates/rustc-codegen-cuda/examples/gemm_sol_final/Cargo.toml",
    ],
}
